{
  "name": "amdern/property-portal-backend",
  "type": "project",
  "description": "Amdern Properties SMC Limited - Laravel 12 Backend with PostGIS",
  "keywords": ["laravel", "real-estate", "postgis", "uganda"],
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/breeze": "^2.0",
    "spatie/laravel-permission": "^6.0",
    "laravel/socialite": "^5.0",
    "laravel/sanctum": "^4.0",
    "laravel/nova": "^4.0",
    "gumlet/laravel-image-optimizer": "^3.0",
    "laravel/passport": "^12.0",
    "laravel/tinker": "^2.0",
    "spatie/laravel-medialibrary": "^11.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.0",
    "mockery/mockery": "^1.6",
    "nunamer/orphan-remover": "^2.0",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^11.0",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --provider=\"Laravel\\Breeze\\BreezeServiceProvider\" --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
        "providers": [
          "App\\Providers\\AppServiceProvider",
          "Spatie\\Permission\\PermissionServiceProvider",
          "Laravel\\Socialite\\SocialiteServiceProvider",
          "Laravel\\Sanctum\\SanctumServiceProvider"
        ]
    }
  }
}