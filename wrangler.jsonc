{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amdern-properties",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "amdernpropertiessmclimited.com",
      "custom_domain": true
    },
    {
      "pattern": "www.amdernpropertiessmclimited.com",
      "custom_domain": true
    }
  ]
}
